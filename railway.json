{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "services": {
    "backend": {
      "rootDirectory": "backend",
      "build": {
        "builder": "NIXPACKS"
      }
    },
    "frontend": {
      "rootDirectory": "frontend",
      "build": {
        "builder": "NIXPACKS"
      }
    }
  }
}
